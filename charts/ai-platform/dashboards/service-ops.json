{
 "uid": "ax-service-ops",
 "title": "AX · 서비스 운영 (사용자·권한·데이터)",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "15s",
 "tags": [
  "ax-platform-lab"
 ],
 "panels": [
  {
   "id": 1,
   "title": "역할별 요청 수 (/분)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (role) (rate(ax_requests_total[5m])) * 60",
     "legendFormat": "{{role}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {},
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   }
  },
  {
   "id": 2,
   "title": "권한 거부 (/10분)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (role, tool) (increase(ax_permission_denied_total[10m]))",
     "legendFormat": "{{role}} → {{tool}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 7
   }
  },
  {
   "id": 3,
   "title": "검색 근거 0건 비율 (1시간)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(ax_search_empty_total[1h])) / clamp_min(sum(increase(ax_search_total[1h])), 1)",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {},
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 7
   }
  },
  {
   "id": 4,
   "title": "응답 결과 (answered / unknown / error)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (result) (rate(ax_requests_total[5m])) * 60",
     "legendFormat": "{{result}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {},
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 8,
    "h": 7
   }
  },
  {
   "id": 5,
   "title": "입구 5xx 비율 (알람 2%)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(traefik_service_requests_total{code=~\"5..\"}[5m])) / clamp_min(sum(rate(traefik_service_requests_total[5m])), 1e-9)",
     "legendFormat": "5xx",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.02
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "gridPos": {
    "x": 8,
    "y": 7,
    "w": 8,
    "h": 7
   }
  },
  {
   "id": 6,
   "title": "응답 시간 p95 (게이트웨이)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(ax_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {},
   "gridPos": {
    "x": 16,
    "y": 7,
    "w": 8,
    "h": 7
   }
  },
  {
   "id": 7,
   "title": "DB 연결 수",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (datname) (pg_stat_database_numbackends{datname=\"hanbit\"})",
     "legendFormat": "{{datname}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {},
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 7
   }
  },
  {
   "id": 8,
   "title": "PVC 사용률 (kind local-path는 수집 안 됨)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes",
     "legendFormat": "{{persistentvolumeclaim}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 80
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "gridPos": {
    "x": 8,
    "y": 14,
    "w": 8,
    "h": 7
   }
  },
  {
   "id": 9,
   "title": "마지막 DB 백업 성공",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "kube_cronjob_status_last_successful_time{cronjob=\"pg-backup\"} * 1000",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dateTimeFromNow",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {},
   "gridPos": {
    "x": 16,
    "y": 14,
    "w": 8,
    "h": 7
   }
  },
  {
   "id": 10,
   "title": "발생 중인 알람",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(ALERTS{alertstate=\"firing\", severity=~\"critical|warning\"}) or vector(0)",
