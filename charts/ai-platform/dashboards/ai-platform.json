 "panels": [
  {
   "id": 1,
   "title": "GPU 사용률",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "DCGM_FI_DEV_GPU_UTIL",
     "legendFormat": "GPU {{gpu}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {},
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   }
  },
  {
